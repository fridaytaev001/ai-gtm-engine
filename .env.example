# Copy to .env and fill in what each chunk needs. Never commit .env.
# The web app reads apps/web/.env.local (or the Vercel project settings);
# the worker reads this root .env.

# --- App database + knowledge graph (chunk 2) ---
DATABASE_URL=            # Postgres (Neon or Supabase) connection string
NEO4J_URI=               # neo4j+s://<id>.databases.neo4j.io (AuraDB Free)
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=           # Aura shows this in the credentials file (often the instance id)

# --- LLM (chunk 3) ---
ANTHROPIC_API_KEY=

# --- Discovery (chunk 4) ---
TAVILY_API_KEY=

# --- Billing (chunk 6) ---
FLEXPRICE_API_KEY=       # server-side secret key from the Flexprice dashboard
FLEXPRICE_API_HOST=https://us.api.flexprice.io/v1
FLEXPRICE_WEBHOOK_SECRET=  # whsec_... for webhook signature checks

# --- Enrichment (chunk 7) ---
APOLLO_API_KEY=
HUNTER_API_KEY=
PROSPEO_API_KEY=

# --- Outreach (chunk 8) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=            # the test inbox address that sends demo emails

# --- Multi-agent orchestration (chunk 10) ---
BAND_API_URL=https://api.band.ai
BAND_PLANNER_API_KEY=
BAND_BUILDER_API_KEY=
BAND_REVIEWER_API_KEY=
BAND_SECURITY_API_KEY=

# --- Semantic search (chunk 12) ---
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# --- Worker ---
WORKER_PORT=8787
