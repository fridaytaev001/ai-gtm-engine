{
  "name": "@gtm/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./graph": "./src/graph/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "graph:setup": "tsx --env-file-if-exists=../../.env scripts/graph-setup.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "db:check": "tsx --env-file-if-exists=../../.env scripts/check.ts"
  },
  "dependencies": {
    "@gtm/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "neo4j-driver": "^6.3.2",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
