{
  "name": "ai-gtm-engine",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @gtm/web dev",
    "dev:worker": "pnpm --filter @gtm/worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
